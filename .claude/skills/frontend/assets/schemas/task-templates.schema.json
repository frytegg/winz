{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:task-templates:1",
  "title": "/frontend task templates for /execution",
  "description": "assets/task-templates/frontend.json (ARCHITECTURE.md section 12, scripts/CONTRACTS.md 6.1b, /execution ARCHITECTURE.md 3.2, 4.2 and 19). /execution's planner instantiates these templates in place of a generic UI template; exec.py plan instantiate resolves every parameter and dependency at instantiation, never at runtime, following the file's rules.",
  "type": "object",
  "required": ["$schema", "library", "version", "agreed", "skill_root", "rules", "placeholders", "symbolic_depends", "params", "stacks", "templates"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "library": {"const": "frontend"},
    "version": {"const": 1},
    "agreed": {"type": "string", "minLength": 1},
    "skill_root": {"type": "string", "pattern": "^[A-Za-z]:/"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "placeholders": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^\\{[a-z_]+\\}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "symbolic_depends": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/symbolicDep"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "params": {
      "type": "object",
      "required": ["references", "mode"],
      "additionalProperties": false,
      "properties": {
        "references": {"$ref": "#/$defs/paramDef"},
        "mode": {"$ref": "#/$defs/paramDef"}
      }
    },
    "stacks": {
      "type": "object",
      "required": ["vite-react", "next", "static-html", "existing"],
      "additionalProperties": false,
      "properties": {
        "vite-react": {"$ref": "#/$defs/stack"},
        "next": {"$ref": "#/$defs/stack"},
        "static-html": {"$ref": "#/$defs/stack"},
        "existing": {"$ref": "#/$defs/stack"}
      }
    },
    "templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}}
  },
  "$defs": {
    "templateId": {"type": "string", "pattern": "^FE-([0-9]{2}|1x)$"},
    "symbolicDep": {"type": "string", "pattern": "^(decision|manual):[a-z][a-z0-9-]*$"},
    "dep": {"anyOf": [{"$ref": "#/$defs/templateId"}, {"$ref": "#/$defs/symbolicDep"}]},
    "paramDef": {
      "type": "object",
      "required": ["values", "default", "source", "description"],
      "additionalProperties": false,
      "properties": {
        "values": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "default": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "stack": {
      "type": "object",
      "required": ["replace", "add_resources", "sections", "note"],
      "additionalProperties": false,
      "properties": {
        "sections": {"enum": ["parallel", "serial"], "description": "serial: FE-1x instances are chained in group order, because the stack keeps every section in shared files."},
        "replace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string"}}
          }
        },
        "add_resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "note": {"type": "string"}
      }
    },
    "resource": {"type": "string", "pattern": "^(manifest|browser|port:\\{preview\\})$"},
    "range": {
      "type": "object",
      "required": ["p10", "p50", "p90"],
      "additionalProperties": false,
      "properties": {
        "p10": {"type": "number", "exclusiveMinimum": 0},
        "p50": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "override": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "include": {"type": "boolean"},
        "depends": {"type": "array", "items": {"$ref": "#/$defs/dep"}},
        "writes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "instances": {"enum": ["single", "per-group"]}
      }
    },
    "manual": {
      "type": "object",
      "required": ["steps", "bring_back", "options_source", "where"],
      "additionalProperties": false,
      "properties": {
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "bring_back": {"type": "string", "minLength": 1},
        "options_source": {"type": ["string", "null"], "minLength": 1},
        "where": {"enum": ["phone", "laptop"]}
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "spec", "expect", "max_runtime_min", "negative_control"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["command", "file"]},
        "spec": {"type": "string", "minLength": 1},
        "expect": {"type": "string", "minLength": 1},
        "max_runtime_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 15},
        "negative_control": {"type": "string", "minLength": 1}
      }
    },
    "fragment": {
      "type": "object",
      "required": ["file", "function", "input"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "pattern": "^[A-Za-z]:/.+/assets/wave-fragments/[a-z-]+\\.js$"},
        "function": {"enum": ["feCritique", "feDirections"]},
        "input": {"type": "object", "minProperties": 1}
      }
    },
    "template": {
      "type": "object",
      "required": ["id", "title", "description", "kind", "phase", "pre_t0", "runner", "fragment", "instances", "params", "depends", "covers", "writes", "resources", "estimate", "model", "effort", "proof", "brief_refs", "small_mode", "manual"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/templateId"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "kind": {"enum": ["code", "research", "manual", "decision", "gate"]},
        "phase": {"enum": ["build", "manual", "decision", "deliverable"]},
        "pre_t0": {"type": "boolean", "description": "May run before kickoff as research, with --state <workspace.private_dir>/frontend; never true for a task that makes a visual."},
        "runner": {"enum": ["agent", "fragment", "owner"]},
        "fragment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fragment"}]},
        "instances": {"enum": ["single", "per-group"]},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "references": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {"on": {"$ref": "#/$defs/override"}, "off": {"$ref": "#/$defs/override"}}
            },
            "mode": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {"full": {"$ref": "#/$defs/override"}, "small": {"$ref": "#/$defs/override"}}
            }
          }
        },
        "depends": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dep"}},
        "covers": {
          "type": "object",
          "required": ["rule", "depends_on_covering_tasks", "description"],
          "additionalProperties": false,
          "properties": {
            "rule": {"enum": ["none", "feature-group"]},
            "depends_on_covering_tasks": {"type": "boolean"},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "writes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}},
        "estimate": {
          "type": "object",
          "required": ["full", "small", "verify", "basis"],
          "additionalProperties": false,
          "properties": {
            "full": {"$ref": "#/$defs/range"},
            "small": {"$ref": "#/$defs/range"},
            "verify": {"$ref": "#/$defs/range"},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        "model": {"enum": ["opus", "sonnet", "haiku", null]},
        "effort": {"enum": ["low", "medium", "high", null], "description": "Capped at high (owner effort policy, 2026-10-02; /execution clamps anything above high and warns W_EFFORT_CAPPED)."},
        "proof": {"$ref": "#/$defs/proof"},
        "brief_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C:/Users/Utilisateur/\\.claude/skills/frontend/references/[0-9]{2}-[a-z0-9-]+\\.md$"}
        },
        "small_mode": {
          "type": "object",
          "required": ["include", "note"],
          "additionalProperties": false,
          "properties": {
            "include": {"type": "boolean"},
            "note": {"type": "string", "minLength": 1}
          }
        },
        "manual": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/manual"}]}
      },
      "allOf": [
        {
          "description": "Owner tasks carry steps, take no model and prove themselves with the answer file.",
          "if": {"properties": {"kind": {"enum": ["manual", "decision"]}}},
          "then": {
            "properties": {
              "runner": {"const": "owner"},
              "manual": {"type": "object"},
              "model": {"const": null},
              "effort": {"const": null},
              "fragment": {"const": null},
              "proof": {"properties": {"type": {"const": "file"}}}
            }
          },
          "else": {
            "properties": {
              "runner": {"enum": ["agent", "fragment"]},
              "manual": {"const": null},
              "model": {"type": "string"},
              "effort": {"type": "string"},
              "proof": {"properties": {"type": {"const": "command"}}}
            }
          }
        },
        {
          "description": "A fragment task names its fragment; an agent task has none.",
          "if": {"properties": {"runner": {"const": "fragment"}}},
          "then": {"properties": {"fragment": {"type": "object"}}},
          "else": {"properties": {"fragment": {"const": null}}}
        }
      ]
    }
  }
}
