{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:critic-output:1",
  "title": "frontend-critic output",
  "description": "The one JSON object a frontend-critic pass returns, by task kind. assets/wave-fragments/critique.js passes each $defs entry, unchanged, as the agent() schema of the matching call (a test keeps the copies equal), and critique.mjs prints the same format in the critic task file. Marks are the ids of the DOM-marked tiles; a critic never returns coordinates or pixel measurements of its own.",
  "oneOf": [
    {"$ref": "#/$defs/critique"},
    {"$ref": "#/$defs/pairwise"},
    {"$ref": "#/$defs/probeMatch"}
  ],
  "$defs": {
    "critique": {
      "type": "object",
      "required": ["pass_id", "kind", "checklist", "issues"],
      "additionalProperties": false,
      "properties": {
        "pass_id": {"type": "string", "minLength": 1},
        "kind": {"const": "critique"},
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "answer"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "answer": {"enum": ["yes", "no", "n/a"]},
              "mark": {"type": "string", "minLength": 1}
            }
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["mark", "category", "problem", "fix"],
            "additionalProperties": false,
            "properties": {
              "mark": {"type": "string", "minLength": 1},
              "item": {"type": "string"},
              "category": {"enum": ["first-view", "feature-proof", "hierarchy", "layout", "typography", "contrast", "copy", "states", "motion", "brand", "other"]},
              "problem": {"type": "string", "minLength": 1},
              "fix": {"type": "string", "minLength": 1},
              "source": {"type": "string"}
            }
          }
        }
      }
    },
    "pairwise": {
      "type": "object",
      "required": ["pass_id", "kind", "checklist", "preferred", "reason"],
      "additionalProperties": false,
      "properties": {
        "pass_id": {"type": "string", "minLength": 1},
        "kind": {"const": "pairwise"},
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "a", "b"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "a": {"enum": ["yes", "no", "n/a"]},
              "b": {"enum": ["yes", "no", "n/a"]}
            }
          }
        },
        "preferred": {"enum": ["A", "B", "tie"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "probeMatch": {
      "type": "object",
      "required": ["pass_id", "kind", "matches"],
      "additionalProperties": false,
      "properties": {
        "pass_id": {"type": "string", "minLength": 1},
        "kind": {"const": "probe-match"},
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["probe", "restates", "reason"],
            "additionalProperties": false,
            "properties": {
              "probe": {"type": "string", "minLength": 1},
              "restates": {"type": "boolean"},
              "what": {"type": "boolean"},
              "does": {"type": "boolean"},
              "for_whom": {"type": "boolean"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
