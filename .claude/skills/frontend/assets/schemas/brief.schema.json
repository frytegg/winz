{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:brief:1",
  "title": "Frontend brief",
  "description": "brief.json in the state directory (scripts/CONTRACTS.md 6.4), compiled by brief.mjs (FE-00). /frontend never invents an input: every non-empty field carries the source path (and line when known) it came from, and a field with no source is listed under missing with the action that will fill it (a manual task in mode A, a question in mode B), never guessed.",
  "type": "object",
  "required": ["project", "sentences", "hero", "gap", "sponsors", "customers", "use_case", "features", "claims", "never_show", "judge_path", "missing"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "name_status", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "name_status": {"enum": ["final", "working", "pending"]},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"$ref": "#/$defs/hasName"},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "sentences": {
      "type": "object",
      "required": ["broken", "did", "source"],
      "additionalProperties": false,
      "description": "The two sentences: what is broken, what we did.",
      "properties": {
        "broken": {"type": "string"},
        "did": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"anyOf": [{"$ref": "#/$defs/hasBroken"}, {"$ref": "#/$defs/hasDid"}]},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "hero": {
      "type": "object",
      "required": ["h1", "sentence", "source"],
      "additionalProperties": false,
      "description": "First-view headline and sentence, read from the two-sentences source; coverage.hero checks the rendered page equals it.",
      "properties": {
        "h1": {"type": "string"},
        "sentence": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"anyOf": [{"$ref": "#/$defs/hasH1"}, {"$ref": "#/$defs/hasSentence"}]},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "gap": {
      "type": "object",
      "required": ["text", "who_loses", "how_much", "source"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string"},
        "who_loses": {"type": "string"},
        "how_much": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"anyOf": [{"$ref": "#/$defs/hasText"}, {"$ref": "#/$defs/hasWhoLoses"}, {"$ref": "#/$defs/hasHowMuch"}]},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "strategy", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Sponsor id as in assets/sponsor-allowlist.json when the sponsor is listed there."},
          "name": {"type": "string", "minLength": 1},
          "strategy": {"type": "string"},
          "source": {"$ref": "#/$defs/requiredSource"}
        }
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "url", "url_source", "owner_confirmed"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "url": {"oneOf": [{"const": ""}, {"type": "string", "format": "uri", "pattern": "^https?://"}]},
          "url_source": {"type": "string"},
          "owner_confirmed": {"type": "boolean"}
        },
        "if": {"properties": {"url": {"minLength": 1}}},
        "then": {"properties": {"url_source": {"minLength": 1, "pattern": "\\S"}}}
      }
    },
    "use_case": {
      "type": "object",
      "required": ["text", "source"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"$ref": "#/$defs/hasText"},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "title", "status", "route", "proof", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^FR-[0-9]{3,}$"},
          "group": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["live", "testnet", "simulated", "planned"]},
          "route": {"type": ["string", "null"], "pattern": "^/"},
          "proof": {"type": ["string", "null"], "minLength": 1, "description": "Claims-ledger id, transaction link or live value that proves the feature."},
          "source": {"$ref": "#/$defs/requiredSource"}
        }
      }
    },
    "claims": {
      "type": "object",
      "required": ["path", "ids"],
      "additionalProperties": false,
      "description": "The claims ledger (profile phase_b.claims_ledger) and the claim ids the UI may render; a number with no verified row renders as a not-yet-verified placeholder.",
      "properties": {
        "path": {"type": "string"},
        "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "never_show": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "pattern", "regex", "until_utc", "source"],
        "additionalProperties": false,
        "properties": {
          "class": {"enum": ["do-not-carry", "undisclosed-security", "never-public", "embargo"]},
          "pattern": {"type": "string", "minLength": 1},
          "regex": {"type": "boolean"},
          "until_utc": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time", "pattern": "Z$"}]},
          "source": {"$ref": "#/$defs/requiredSource"}
        }
      }
    },
    "judge_path": {
      "type": "object",
      "required": ["beats", "source"],
      "additionalProperties": false,
      "properties": {
        "beats": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"properties": {"beats": {"minItems": 1}}},
      "then": {"$ref": "#/$defs/sourced"}
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "action", "why"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string", "minLength": 1, "description": "Dotted path of the missing field, for example hero.h1."},
          "action": {"enum": ["manual-task", "question"]},
          "why": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "source": {"type": "string", "description": "Path (and :line when known) of the file the field came from; empty only when the field is empty."},
    "requiredSource": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sourced": {"properties": {"source": {"minLength": 1, "pattern": "\\S"}}},
    "hasName": {"required": ["name"], "properties": {"name": {"minLength": 1}}},
    "hasBroken": {"required": ["broken"], "properties": {"broken": {"minLength": 1}}},
    "hasDid": {"required": ["did"], "properties": {"did": {"minLength": 1}}},
    "hasH1": {"required": ["h1"], "properties": {"h1": {"minLength": 1}}},
    "hasSentence": {"required": ["sentence"], "properties": {"sentence": {"minLength": 1}}},
    "hasText": {"required": ["text"], "properties": {"text": {"minLength": 1}}},
    "hasWhoLoses": {"required": ["who_loses"], "properties": {"who_loses": {"minLength": 1}}},
    "hasHowMuch": {"required": ["how_much"], "properties": {"how_much": {"minLength": 1}}}
  }
}
