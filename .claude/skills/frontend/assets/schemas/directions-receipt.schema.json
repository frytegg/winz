{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:directions-receipt:1",
  "title": "Directions receipt",
  "description": "What feDirections (assets/wave-fragments/directions.js) returns for FE-03 (ARCHITECTURE.md P2). ok is true only when every direction was drawn, rendered and screened clean, the generic plan for the similar-prompt test exists and the board was written. The FE-03 proof itself is frontend-check --gates directions on the files under <state>/directions/.",
  "type": "object",
  "required": ["fragment", "version", "task", "ok", "mode", "references", "count", "generic", "directions", "board", "error"],
  "additionalProperties": false,
  "properties": {
    "fragment": {"const": "feDirections"},
    "version": {"const": 1},
    "task": {"type": "string"},
    "ok": {"type": "boolean"},
    "mode": {"enum": ["full", "small"]},
    "references": {"enum": ["on", "off"]},
    "count": {"type": "integer", "minimum": 1, "maximum": 3},
    "generic": {
      "type": "object",
      "required": ["sentence", "ok", "dir"],
      "additionalProperties": false,
      "properties": {
        "sentence": {"type": "string", "description": "The generic brief: category and surface, no name, number or research."},
        "ok": {"type": "boolean"},
        "dir": {"type": "string"}
      }
    },
    "directions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "anchor", "name", "attempts", "rendered", "screened", "findings", "files"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-C]$"},
          "anchor": {"enum": ["customer-a", "customer-b", "domain", "utilitarian", "category"]},
          "name": {"type": "string"},
          "attempts": {"type": "integer", "minimum": 0},
          "rendered": {"type": "boolean"},
          "screened": {"type": "boolean"},
          "findings": {"type": "array", "items": {"type": "string"}},
          "files": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "tokens, notes, hero, hero_desktop and hero_mobile paths."
          }
        }
      }
    },
    "board": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["ok", "path"],
          "additionalProperties": false,
          "properties": {"ok": {"type": "boolean"}, "path": {"type": "string"}}
        }
      ]
    },
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {
        "properties": {
          "error": {"type": "null"},
          "board": {"type": "object", "properties": {"ok": {"const": true}}},
          "generic": {"properties": {"ok": {"const": true}}},
          "directions": {"minItems": 1, "items": {"properties": {"screened": {"const": true}, "rendered": {"const": true}}}}
        }
      }
    }
  ]
}
