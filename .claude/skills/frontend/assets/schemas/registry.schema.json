{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:registry:1",
  "title": "Rule registry",
  "description": "scripts/rules/registry.json (scripts/CONTRACTS.md section 5). One entry per anti-slop rule; detector files are named by id under rules/static/ and rules/runtime/, matching the static and runtime flags. Every rule starts at tier candidate until calibrate.mjs and the owner set its tier.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "generated": {"type": "string", "description": "Date the file was last generated or edited (registry builder's addition)."},
    "note": {"type": "string"},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^SL-[A-Z]{1,2}[0-9]{1,2}$",
      "description": "Stable rule id: SL-T01..SL-T20 owner tells, SL-M01..SL-M17 missing tells, SL-C, SL-G, SL-X and SL-MO families."
    },
    "count": {
      "type": "object",
      "required": ["fired", "total"],
      "additionalProperties": false,
      "properties": {
        "fired": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "family", "title", "tell", "static", "runtime", "tier", "anchor", "weight", "scope", "falsePositives", "fix", "sources", "allowlist", "calibration"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "family": {"enum": ["owner-tell", "missing-tell", "claude-era", "generator", "invented", "motion", "copy", "web3"]},
        "title": {"type": "string", "minLength": 1},
        "tell": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 20,
          "description": "The owner's tell number (1-20) for owner-tell rules, null otherwise."
        },
        "static": {"type": "boolean"},
        "runtime": {"type": "boolean"},
        "tier": {"enum": ["candidate", "tier1", "tier2", "advisory"]},
        "anchor": {"type": "boolean", "description": "Anchor rules count double in tells.score."},
        "weight": {"type": "number", "minimum": 0},
        "grade": {"enum": ["A", "B", "C", "D"], "description": "Grade of the evidence the rule rests on (registry builder's addition)."},
        "scope": {"type": "string", "minLength": 1},
        "falsePositives": {"type": "string", "minLength": 1},
        "fix": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowlist": {"enum": ["sponsor-hash", "category", "none"]},
        "calibration": {
          "type": "object",
          "required": ["positives", "controls", "exemplars", "date", "notes"],
          "additionalProperties": false,
          "properties": {
            "positives": {"$ref": "#/$defs/count"},
            "controls": {"$ref": "#/$defs/count"},
            "exemplars": {"$ref": "#/$defs/count"},
            "date": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
              "description": "Date (or UTC date-time) of the last calibration run, null before the first."
            },
            "notes": {"type": "string"}
          }
        }
      },
      "allOf": [
        {
          "description": "A rule needs at least one detector layer.",
          "anyOf": [
            {"properties": {"static": {"const": true}}},
            {"properties": {"runtime": {"const": true}}}
          ]
        },
        {
          "description": "Owner tells carry their tell number; other families carry null.",
          "if": {"properties": {"family": {"const": "owner-tell"}}},
          "then": {"properties": {"tell": {"type": "integer"}}},
          "else": {"properties": {"tell": {"type": "null"}}}
        }
      ]
    }
  }
}
