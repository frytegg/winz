{
  "name": "frontend-skill-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scripts of the /frontend Claude Code skill: capture, tokens, brand, checks, calibration.",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "test": "pnpm run test:fast && pnpm run test:browser",
    "test:fast": "node --test \"tests/**/!(*.browser).test.mjs\"",
    "test:browser": "node --test --test-concurrency=2 --test-timeout=300000 \"tests/**/*.browser.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adobe/leonardo-contrast-colors": "1.1.0",
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "opentype.js": "2.0.0",
    "playwright-core": "1.59.1",
    "png-to-ico": "3.0.2",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
