{
  "schema": "execution.fixture/1",
  "name": "Queue Clock",
  "version": "1.0.0",
  "description": "Neutral rehearsal template for /execution and /frontend (contract/FIXTURE.md). exec.py fixture new copies workspace/ to <dest>/private/ and repo/ to <dest>/repo/, renders the tokens, shifts the data times, applies the mode and two-dev patches, and commits repo/ as a fresh git repository.",
  "layout": {
    "workspace": "private",
    "repo": "repo",
    "scratch": "scratch",
    "remotes": "remotes",
    "repo_b": "repo-b"
  },
  "time": {
    "t0_rule": "ceil(now to the next multiple of 5 minutes) + 30 minutes",
    "end_rule": "t0 + 360 minutes",
    "frame_rule": "the latest instant with time 12:00:00Z that is at or before t0 - 60 minutes",
    "template_anchor_utc": "2026-01-10T12:00:00Z",
    "shift_files": [
      "repo/data/exit-rate-series.json",
      "repo/data/queue-snapshots.json",
      "repo/data/requests.json"
    ],
    "shift_rule": "every JSON string value that matches ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ is moved by (frame - template_anchor_utc), a whole number of days; nothing else in these files changes"
  },
  "render": {
    "token_files": [
      "workspace/SPEC.md",
      "workspace/two-sentences.md",
      "workspace/event-brief.md",
      "workspace/customers.json",
      "workspace/claims-ledger.md",
      "workspace/dx-journal.md",
      "workspace/run-sheet.md",
      "workspace/never-show.json",
      "workspace/profile.json",
      "workspace/policy.json",
      "workspace/research/README.md",
      "workspace/research/probes/probe-notes.md",
      "repo/README.md",
      "repo/data/README.md"
    ],
    "renames": {
      "workspace/profile.json": "private/profile.draft.json",
      "workspace/policy.json": "private/policy.draft.json"
    },
    "copy_only": [
      "repo/.gitattributes",
      "repo/.gitignore"
    ],
    "not_copied": [
      "fixture.json",
      "tools/**"
    ]
  },
  "modes": {
    "small": {
      "mode": "small",
      "stack": "static-html",
      "critique": {"rounds_max": 1, "critics": 3, "probes": 5},
      "budget": {"ui_hours": 2, "tokens": null}
    },
    "full": {
      "mode": "full",
      "stack": "vite-react",
      "critique": {"rounds_max": 3, "critics": 3, "probes": 5},
      "budget": {"ui_hours": 6, "tokens": null}
    }
  },
  "two_dev": {
    "dev_b": {
      "id": "devB",
      "name": "Dev B (rehearsal second orchestrator)",
      "executor": "B",
      "setup": "full",
      "notion_member": true,
      "availability": [
        {"start_utc": "{{t:now-10m}}", "end_utc": "{{t:end+3h}}", "kind": "awake"}
      ]
    }
  },
  "variants": {
    "a": {"slug": "queue-clock"},
    "b": {"slug": "queue-clock-b"}
  },
  "github": {
    "product_repo_name": "{{slug}}-{{stamp}}",
    "state_repo_name": "{{slug}}-{{stamp}}-state",
    "visibility": "private",
    "deletion": "never automatic: the hand-over lists both repositories for the owner to delete by hand"
  }
}
