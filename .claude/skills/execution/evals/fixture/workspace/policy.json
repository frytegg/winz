{
  "schema": "execution.policy/1",
  "git": {
    "commit": true,
    "push": true,
    "force": "never",
    "history_rewrite": "never",
    "push_freeze_utc": "{{t:end}}",
    "conventional_commits": true,
    "attribution_trailers": "never"
  },
  "networks": {
    "testnet": {
      "allowed": true,
      "chains": [
        {"chain": "ethereum", "network": "hoodi", "ceiling": "0.5", "unit": "ETH", "per": "wave"}
      ]
    },
    "mainnet": {
      "mode": "read-only",
      "setup_task": null,
      "ceiling": null,
      "unit": null,
      "per_wave_ceiling": null,
      "broadcast_patterns": [
        "(?i)\\b(cast|forge)\\s+(send|script)\\b[^\\n]*\\bmainnet\\b",
        "(?i)eth_sendRawTransaction[^\\n]*https?://[^\\s\"']*mainnet|https?://[^\\s\"']*mainnet[^\\n]*eth_sendRawTransaction"
      ]
    }
  },
  "deny_endpoints": [
    {"pattern": "wq-api.lido.fi", "regex": false, "reason": "The rehearsal uses frozen synthetic data only; the live withdrawal-queue API is out of scope (SPEC.md section 7)."}
  ],
  "deny_commands": [
    {"pattern": "(?i)\\bp?npm\\s+publish\\b", "reason": "Nothing is published from a rehearsal."}
  ],
  "fences": {
    "deny_read": ["{{p:private}}/research/probes/**"],
    "deny_write_outside_repo": true,
    "allow_write_outside": ["{{p:scratch}}"]
  },
  "secrets": {
    "env_file": null,
    "agents_read_keys": false,
    "loading": "in-process"
  }
}
