{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/status.schema.json",
  "title": ".execution/status/<executor>.json, task status of one orchestrator",
  "description": "Written only by the exec.py commands run by the orchestrator named in `executor` (SCHEMAS.md section 4). A task id appears in exactly one status file: the one of its plan executor. Tasks of the plan with no entry are `planned`. Every change is also an events.jsonl line of type task.status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executor", "plan_version", "updated_utc", "seq", "tasks"],
  "properties": {
    "schema": {"const": "execution.status/1"},
    "executor": {"$ref": "common.schema.json#/$defs/executor"},
    "plan_version": {"type": "integer", "minimum": 1, "description": "The plan version this file was last reconciled against."},
    "updated_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "seq": {"type": "integer", "minimum": 0, "description": "Incremented on every write; a reader holding an older seq re-reads."},
    "tasks": {
      "type": "object",
      "propertyNames": {"pattern": "^T[0-9]{3,}$"},
      "additionalProperties": {"$ref": "#/$defs/task_status"}
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at_utc", "by", "evidence"],
      "properties": {
        "from": {"$ref": "common.schema.json#/$defs/task_status"},
        "to": {"$ref": "common.schema.json#/$defs/task_status"},
        "at_utc": {"$ref": "common.schema.json#/$defs/utc"},
        "by": {
          "description": "The exec.py subcommand that performed it (SCHEMAS.md 4.2 table), e.g. 'wave ingest', 'answers ingest', 'task set-status'.",
          "type": "string",
          "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)?$"
        },
        "evidence": {
          "description": "Paths (state-relative) or ids backing the transition: a receipt, a merge receipt, a result file, an answer file, a decision id, a wave id.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string"}
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "started_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
        "finished_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
        "wall_min": {"type": ["number", "null"], "minimum": 0},
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "usd_list": {"type": ["number", "null"], "minimum": 0},
        "model": {"$ref": "common.schema.json#/$defs/model_or_null"},
        "effort": {"$ref": "common.schema.json#/$defs/effort_or_null"},
        "verify_wall_min": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "task_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "since_utc", "attempts", "history"],
      "properties": {
        "status": {"$ref": "common.schema.json#/$defs/task_status"},
        "since_utc": {"$ref": "common.schema.json#/$defs/utc"},
        "attempts": {"type": "integer", "minimum": 0, "description": "Counted failures (verifier fail, merge refusal, implementer failure). A null/missing agent result is a rerun and never increments it."},
        "reruns": {"type": "integer", "minimum": 0, "description": "Every null or exit-3 rerun of the task; the run key k of a<n>r<k>."},
        "consecutive_reruns": {"type": "integer", "minimum": 0, "description": "Reruns since the last landed merge, verdict or counted failure; at 3 without usage-limit evidence the task goes blocked-decision (SCHEMAS.md 4.4)."},
        "wave": {"anyOf": [{"$ref": "common.schema.json#/$defs/wave_id"}, {"type": "null"}]},
        "lane": {"anyOf": [{"$ref": "common.schema.json#/$defs/lane_id"}, {"type": "null"}]},
        "commit": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha40"}, {"type": "null"}], "description": "The implementer's head commit (lane branch)."},
        "landed_sha": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha40"}, {"type": "null"}], "description": "The commit pushed to origin/main by merge."},
        "receipt": {"anyOf": [{"$ref": "common.schema.json#/$defs/state_rel_path"}, {"type": "null"}], "description": "proofs/<task>.json once a verdict exists."},
        "answer": {"anyOf": [{"$ref": "common.schema.json#/$defs/state_rel_path"}, {"type": "null"}], "description": "answers/<key>.md for manual tasks."},
        "decision": {"anyOf": [{"$ref": "common.schema.json#/$defs/decision_id"}, {"type": "null"}], "description": "Open or last decision attached to this task (cut proposal, retry exhausted, H1/H2 resolution)."},
        "blocked": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reason"],
              "properties": {
                "kind": {"enum": ["manual", "decision", "dependency", "resource", "retry-exhausted"]},
                "reason": {"type": "string", "minLength": 1},
                "needed": {"type": "string"}
              }
            }
          ]
        },
        "posted": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at_utc", "push_text"],
              "properties": {
                "at_utc": {"$ref": "common.schema.json#/$defs/utc"},
                "push_text": {"type": "string", "maxLength": 200},
                "reposts": {"type": "integer", "minimum": 0}
              }
            }
          ],
          "description": "Manual and decision tasks: when the owner was notified (manual post)."
        },
        "previous_status": {"anyOf": [{"$ref": "common.schema.json#/$defs/task_status"}, {"type": "null"}], "description": "Set on cut-proposed so a refused cut restores it."},
        "actual": {"$ref": "#/$defs/actual"},
        "history": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
      }
    }
  }
}
