{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/plan-draft.schema.json",
  "title": "Planner draft consumed by `exec.py plan instantiate`",
  "description": "Written by the execution-planner agent to .execution/local/planner/plan.draft.json. Tasks use stable keys instead of T-ids; template instances are requested, never expanded by the model. plan instantiate expands the instances, resolves every dependency, assigns topological T-ids and writes plan.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "spec", "deadlines", "requirements", "feature_groups", "lanes", "protected", "tasks", "instances", "libraries"],
  "properties": {
    "schema": {"const": "execution.plan-draft/1"},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/abs_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "deadlines": {"type": "array", "items": {"$ref": "plan.schema.json#/$defs/deadline"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "plan.schema.json#/$defs/requirement"}},
    "feature_groups": {"type": "array", "items": {"$ref": "plan.schema.json#/$defs/feature_group"}},
    "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "plan.schema.json#/$defs/lane"}},
    "protected": {"$ref": "common.schema.json#/$defs/glob_list"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/draft_task"}},
    "instances": {"type": "array", "items": {"$ref": "#/$defs/instance"}},
    "libraries": {
      "description": "Whole-library instantiations (e.g. /frontend mode A): the library's own inclusion rules pick the templates for the given params; tasks get keys <key>/<template id>[.<group>].",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["library", "key", "params"],
        "properties": {
          "library": {"enum": ["execution", "frontend"]},
          "key": {"$ref": "#/$defs/key"},
          "params": {"type": "object"},
          "executor": {"$ref": "common.schema.json#/$defs/executor"}
        }
      }
    },
    "questions": {
      "description": "Missing inputs the planner could not resolve; each becomes a manual task or a decision at approval.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "action", "why"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "action": {"enum": ["manual-task", "decision"]},
          "why": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,60}$"},
    "draft_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "description", "covers", "priority", "required", "phase", "kind", "owner", "executor", "depends_on", "writes", "resources", "estimate", "model", "effort", "proof", "proof_author"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1},
        "feature_group": {"anyOf": [{"$ref": "common.schema.json#/$defs/group_id"}, {"type": "null"}]},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/req_id"}},
        "story": {"anyOf": [{"type": "string", "pattern": "^US[0-9]{1,3}$"}, {"type": "null"}]},
        "priority": {"$ref": "common.schema.json#/$defs/priority"},
        "required": {"type": "boolean"},
        "phase": {"$ref": "common.schema.json#/$defs/phase"},
        "kind": {"$ref": "common.schema.json#/$defs/kind"},
        "owner": {"$ref": "common.schema.json#/$defs/owner"},
        "executor": {"$ref": "common.schema.json#/$defs/executor"},
        "depends_on": {
          "description": "Keys of draft tasks, or instance keys (<instance key> or <instance key>/<template id> for a multi-task instance), or symbols @spec-approved, @build-complete, @harden-review.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(@[a-z-]+|[a-z0-9][a-z0-9.-]{0,60}(/[A-Z]{2,3}-[A-Za-z0-9-]{1,24}(\\.G[0-9]{1,3})?)?)$"}
        },
        "release_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
        "deadline_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
        "anchor": {"anyOf": [{"$ref": "plan.schema.json#/$defs/anchor"}, {"type": "null"}]},
        "writes": {"$ref": "common.schema.json#/$defs/glob_list"},
        "resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/resource"}},
        "estimate": {"$ref": "common.schema.json#/$defs/estimate"},
        "tokens_est": {"$ref": "common.schema.json#/$defs/tokens_est"},
        "model": {"$ref": "common.schema.json#/$defs/model_or_null"},
        "effort": {"$ref": "common.schema.json#/$defs/effort_or_null"},
        "verify": {"$ref": "plan.schema.json#/$defs/task/properties/verify"},
        "proof": {"$ref": "plan.schema.json#/$defs/proof"},
        "proof_author": {"enum": ["test-designer", "template", "owner", "planner"]},
        "brief_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/abs_path"}},
        "manual": {"anyOf": [{"$ref": "plan.schema.json#/$defs/manual"}, {"type": "null"}]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "key", "params"],
      "properties": {
        "template": {"$ref": "common.schema.json#/$defs/template_ref"},
        "key": {"$ref": "#/$defs/key"},
        "params": {"type": "object", "description": "Values for the library's declared parameters; anything undeclared is refused."},
        "executor": {"$ref": "common.schema.json#/$defs/executor"},
        "depends_on_extra": {"type": "array", "items": {"type": "string", "pattern": "^(@[a-z-]+|[a-z0-9][a-z0-9.-]{0,60}(/[A-Z]{2,3}-[A-Za-z0-9-]{1,24}(\\.G[0-9]{1,3})?)?)$"}}
      }
    }
  }
}
