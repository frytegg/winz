{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/completion-gates.schema.json",
  "title": "Gate output of the generated .execution/completion-check.mjs --json (and of exec.py harden-ready)",
  "description": "/frontend's gate shape {ok, gates:[{id, title, ifDropped, state, detail}]} plus the phase tag. Three states; skipped is OPEN, never passing (the BNB script's --json mode reported a skipped gate as ok: never copy that). ok is true iff every gate of the selected phase(s) has state ok. Exit code 0 iff ok. A gate whose check throws is state fail with detail 'the check itself failed: <message>'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "gates"],
  "properties": {
    "ok": {"type": "boolean"},
    "tool": {"enum": ["completion-check", "harden-ready"]},
    "version": {"const": "1"},
    "at": {"$ref": "common.schema.json#/$defs/utc"},
    "phase_selected": {"type": "string", "pattern": "^(all|(build|harden|deliverable)(,(build|harden|deliverable))*)$", "description": "One phase, all, or a comma list (EX-FIX-GATE runs build,harden)."},
    "profile": {"enum": ["pre-harden", "after-harden"], "description": "harden-ready only (CLI.md harden-ready --after-harden; HANDOVER.md 1.2)."},
    "head": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha40"}, {"type": "null"}]},
    "plan_version": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "fail", "skipped"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "ifDropped", "state", "detail", "phase"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9_-]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "ifDropped": {"type": "string", "minLength": 1, "description": "What a reader would wrongly believe if this gate were removed."},
          "state": {"$ref": "common.schema.json#/$defs/gate_state"},
          "detail": {"type": "string"},
          "phase": {"$ref": "common.schema.json#/$defs/gate_phase"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
