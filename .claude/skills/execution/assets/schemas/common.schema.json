{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/common.schema.json",
  "title": "Shared definitions of /execution",
  "description": "Referenced as common.schema.json#/$defs/<name>. Uses only the JSON Schema subset of contract/MODULES.md (execlib.schema). Enums here are the single source: every other schema refers to them.",
  "$defs": {
    "utc": {
      "description": "A UTC instant, ISO 8601 with a Z suffix, seconds precision (fractions allowed on events only through utc_precise).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "utc_precise": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "utc_or_null": {
      "anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]
    },
    "task_id": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "req_id": {
      "description": "Functional requirement, success criterion, non-functional requirement (assigned by the planner for structural work), or user story.",
      "type": "string",
      "pattern": "^((FR|SC|NFR)-[0-9]{3,}|US[0-9]{1,3})$"
    },
    "group_id": {"type": "string", "pattern": "^G[0-9]{1,3}$"},
    "lane_id": {"type": "string", "pattern": "^L[0-9]{1,2}$"},
    "wave_id": {"type": "string", "pattern": "^W[0-9]{2,3}$"},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{3,}$"},
    "deadline_id": {"type": "string", "pattern": "^DL-[a-z0-9][a-z0-9-]{0,40}$"},
    "answer_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "template_ref": {
      "description": "<library>:<template id>, e.g. frontend:FE-03 or execution:EX-BOOT.",
      "type": "string",
      "pattern": "^(execution|frontend):[A-Z]{2,3}-[A-Za-z0-9-]{1,24}$"
    },
    "template_id": {"type": "string", "pattern": "^[A-Z]{2,3}-[A-Za-z0-9-]{1,24}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "glob": {
      "description": "Repository-relative POSIX glob (fnmatch segments plus ** for any depth). Never absolute, never a backslash, never '..'.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!.*\\.\\.)[^\\\\\\x00-\\x1f]+$"
    },
    "abs_path": {
      "description": "Absolute path with forward slashes: C:/... on Windows or /... on POSIX.",
      "type": "string",
      "minLength": 2,
      "pattern": "^([A-Za-z]:/|/)[^\\\\\\x00-\\x1f]*$"
    },
    "abs_path_or_null": {"anyOf": [{"$ref": "#/$defs/abs_path"}, {"type": "null"}]},
    "state_rel_path": {
      "description": "Path relative to the state directory (.execution/), POSIX separators.",
      "type": "string",
      "pattern": "^(?![/~])(?![A-Za-z]:)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "executor": {"enum": ["A", "B"]},
    "dev": {"enum": ["devA", "devB"]},
    "owner": {"enum": ["agent", "devA", "devB"]},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "phase": {
      "enum": ["setup", "contract", "build", "integrate", "verify", "ops", "recon", "audit", "manual", "decision", "deliverable", "fix"]
    },
    "kind": {
      "enum": ["code", "test", "infra", "deploy", "tx", "research", "manual", "decision", "watch", "gate"]
    },
    "task_status": {
      "enum": ["planned", "ready", "running", "built", "verifying", "done", "failed", "blocked-manual", "blocked-decision", "cut-proposed", "cut", "superseded"]
    },
    "run_state": {
      "enum": ["INIT", "PREFLIGHT", "INGEST", "PLAN", "AWAIT_APPROVAL", "RUNNING", "AWAITING_HUMAN", "AWAITING_DECISION", "PAUSED_QUOTA", "PAUSED_RESOURCES", "STUCK", "BUILD_COMPLETE", "HANDED_OVER", "FIX"]
    },
    "model": {"enum": ["opus", "sonnet", "haiku"]},
    "model_or_null": {"anyOf": [{"$ref": "#/$defs/model"}, {"type": "null"}]},
    "effort": {"enum": ["low", "medium", "high"]},
    "effort_or_null": {"anyOf": [{"$ref": "#/$defs/effort"}, {"type": "null"}]},
    "agent_role": {
      "enum": ["planner", "test-designer", "implementer", "integrator", "verifier", "reviewer", "critic", "probe", "convergence"]
    },
    "agent_type": {
      "enum": ["execution-planner", "execution-test-designer", "execution-implementer", "execution-verifier", "execution-reviewer", "frontend-critic", "frontend-probe", "general-purpose"]
    },
    "resource": {
      "description": "Unary resources. manifest = package manifest + lockfile + workspace config (one shared resource); wallet:<name> = a signing key's nonce/UTXO set; port:<n>; db:<name>; browser = a Playwright/frontend-check run; human:<dev>; disk-heavy = an install or heavy build slot.",
      "type": "string",
      "pattern": "^(manifest|browser|disk-heavy|wallet:[a-z0-9][a-z0-9-]{0,30}|port:[0-9]{2,5}|db:[a-z0-9][a-z0-9-]{0,30}|human:(devA|devB))$"
    },
    "gate_phase": {"enum": ["build", "harden", "deliverable"]},
    "gate_state": {"enum": ["ok", "fail", "skipped"]},
    "proof_type": {"enum": ["command", "tx", "ci", "file", "url", "human-attest"]},
    "money": {
      "description": "Monetary amount as a decimal string (never a float).",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10_min", "p50_min", "p90_min", "source"],
      "properties": {
        "p10_min": {"type": "number", "minimum": 0},
        "p50_min": {"type": "number", "minimum": 0},
        "p90_min": {"type": "number", "minimum": 0},
        "source": {
          "description": "reference-class:<build|verify|research|manual> (the owner's 355 logged agents), template:<library> (template's own per-mode figures), owner (typed by the owner), planner (judgement, shown in the approval), calibrated:<wave> (after recalibration).",
          "type": "string",
          "pattern": "^(reference-class:(build|verify|research|manual)|template:(execution|frontend)|owner|planner|calibrated:W[0-9]{2,3})$"
        }
      }
    },
    "tokens_est": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd_list", "basis"],
      "properties": {
        "usd_list": {"type": "number", "minimum": 0},
        "basis": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[EW]_[A-Z0-9_]{2,40}$"},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "task": {"$ref": "#/$defs/task_id"},
        "hint": {"type": "string"}
      }
    },
    "display_time": {
      "description": "A UTC instant with its renderings in the profile's display zones.",
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "display"],
      "properties": {
        "utc": {"$ref": "#/$defs/utc"},
        "display": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "label -> 'Wed 7 Oct 23:59 SGT' style text."
        }
      }
    },
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "glob_list": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "uniqueItems": true},
    "run_ref": {
      "description": "A proof-run id: <task>-<sha8>-<yyyymmddThhmmssZ>-<n>.",
      "type": "string",
      "pattern": "^T[0-9]{3,}-[0-9a-f]{8}-[0-9]{8}T[0-9]{6}Z-[0-9]{1,3}$"
    }
  }
}
