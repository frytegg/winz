{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/result-reviewer.schema.json",
  "title": "Structured result of the execution-reviewer agent (adversarial pass at milestones, and the convergence pass)",
  "description": "Self-contained (inlined as the agent() schema). The reviewer gets the plan as the contract and the burden of proof is on 'done': a finding of missing or partial work under an approved requirement becomes a task through amend; anything wider becomes a decision. Planted defects measure the review itself. Recorded with `exec.py result put --role reviewer`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "mode", "wave", "scope", "planted_defects", "findings", "gaps", "verdict", "notes"],
  "properties": {
    "schema": {"const": "execution.result.reviewer/1"},
    "role": {"const": "reviewer"},
    "mode": {"enum": ["milestone", "convergence"]},
    "wave": {"type": "string", "pattern": "^W[0-9]{2,3}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "tasks"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tasks": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}}
      }
    },
    "planted_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "caught", "caught_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^PD[0-9]{1,3}$"},
          "description": {"type": "string", "minLength": 1},
          "caught": {"type": "boolean"},
          "caught_by": {"type": ["string", "null"], "description": "The test, gate or proof that failed on the planted defect."}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "claim", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{1,3}$"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "claim": {"type": "string", "minLength": 1},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "fix": {"type": "string"},
          "task": {"type": ["string", "null"], "pattern": "^T[0-9]{3,}$"}
        }
      }
    },
    "gaps": {
      "description": "Convergence gaps against the plan (spec-kit converge types).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "type", "evidence", "within_approved_scope"],
        "properties": {
          "requirement": {"type": "string", "pattern": "^((FR|SC|NFR)-[0-9]{3,}|US[0-9]{1,3})$"},
          "type": {"enum": ["missing", "partial", "contradicts", "unrequested"]},
          "evidence": {"type": "string", "minLength": 1},
          "within_approved_scope": {"type": "boolean"}
        }
      }
    },
    "verdict": {"enum": ["clean", "issues"]},
    "notes": {"type": "string", "maxLength": 3000}
  }
}
