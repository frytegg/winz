{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/proof-receipt.schema.json",
  "title": "Verifier receipt: .execution/proofs/<task>.json",
  "description": "Written only by `exec.py proof verdict`, invoked by an execution-verifier agent that did not write the task. The receipt is what `done` rests on (SCHEMAS.md 4.3): verdict pass, sha on origin/main, proof_hash equal to the plan's, a run of this sha cited by id whose exit code matches the verdict, and the negative control when one is required. The previous receipt of the same task moves to proofs/history/<task>.a<attempt>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "attempt", "executor", "plan_version", "proof_hash", "sha", "on_origin_main", "run", "command", "exit_code", "output_sha256", "negative_control", "verdict", "criteria", "findings", "integrity", "by", "implementer", "written_utc"],
  "properties": {
    "schema": {"const": "execution.proof-receipt/1"},
    "task": {"$ref": "common.schema.json#/$defs/task_id"},
    "attempt": {"type": "integer", "minimum": 1},
    "executor": {"$ref": "common.schema.json#/$defs/executor"},
    "plan_version": {"type": "integer", "minimum": 1},
    "proof_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "sha": {"$ref": "common.schema.json#/$defs/sha40"},
    "on_origin_main": {"type": "boolean", "description": "git merge-base --is-ancestor <sha> origin/main after a fetch, at verdict time."},
    "run": {"$ref": "common.schema.json#/$defs/run_ref"},
    "command": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "output_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "negative_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "ran", "exit_code", "met"],
      "properties": {
        "required": {"type": "boolean", "description": "true for tasks whose proof is new tests or a new checker (SCHEMAS.md P-13)."},
        "ran": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "met": {"type": ["boolean", "null"]}
      }
    },
    "verdict": {"enum": ["pass", "fail"]},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "met", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "met": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "claim", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{1,3}$"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "claim": {"type": "string", "minLength": 1},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "fix": {"type": "string"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests_modified", "skip_markers_added", "assertion_delta", "todo_added", "protected_touched", "stubs"],
      "properties": {
        "tests_modified": {"type": "array", "items": {"type": "string"}},
        "skip_markers_added": {"type": "integer", "minimum": 0},
        "assertion_delta": {"type": ["integer", "null"]},
        "todo_added": {"type": "integer", "minimum": 0},
        "protected_touched": {"type": "array", "items": {"type": "string"}},
        "stubs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "agent_type", "agent_id", "model", "effort"],
      "properties": {
        "role": {"const": "verifier"},
        "agent_type": {"const": "execution-verifier"},
        "agent_id": {"type": ["string", "null"], "description": "From the guard's guard.attest event for this (task, run): the agent that ran proof verdict. Never typed on the command line; null only in documents the done check then refuses (SCHEMAS.md 4.3 condition 5)."},
        "model": {"$ref": "common.schema.json#/$defs/model"},
        "effort": {"$ref": "common.schema.json#/$defs/effort"}
      }
    },
    "implementer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "agent_type", "agent_id", "result"],
      "properties": {
        "commit": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha40"}, {"type": "null"}]},
        "agent_type": {"anyOf": [{"$ref": "common.schema.json#/$defs/agent_type"}, {"type": "null"}]},
        "agent_id": {"type": ["string", "null"], "description": "From the guard's attestation of the merge call that landed the task."},
        "result": {"anyOf": [{"$ref": "common.schema.json#/$defs/state_rel_path"}, {"type": "null"}], "description": "The implementer result (its tracked copy proofs/impl/<task>.a<n>.json); null after a crash between the push and the result, when the merge receipt stands for it."},
        "merge_receipt": {"anyOf": [{"$ref": "common.schema.json#/$defs/state_rel_path"}, {"type": "null"}], "description": "The landed merge receipt the SHA was taken from (tracked copy proofs/merge/<task>.a<n>.json)."}
      }
    },
    "run_copy": {"anyOf": [{"$ref": "common.schema.json#/$defs/state_rel_path"}, {"type": "null"}], "description": "proofs/runs/<task>/<run_id>.json, the tracked copy of the cited run (the other executor's done check reads it)."},
    "written_utc": {"$ref": "common.schema.json#/$defs/utc"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {
        "properties": {
          "on_origin_main": {"const": true},
          "integrity": {"properties": {"skip_markers_added": {"const": 0}, "protected_touched": {"maxItems": 0}}}
        }
      }
    }
  ]
}
