{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/result-verifier.schema.json",
  "title": "Structured result of the execution-verifier agent",
  "description": "Self-contained (inlined as the agent() schema). The verifier ran `exec.py proof run --task --sha` itself and then `exec.py proof verdict`, which wrote proofs/<task>.json; this result repeats the key fields so the wave script can gate dependents without reading files. If the result and the receipt disagree, the receipt wins and wave ingest flags E_RESULT_RECEIPT_MISMATCH. Recorded with `exec.py result put --role verifier`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "wave", "task", "attempt", "sha", "run", "exit_code", "output_sha256", "negative_control_failed_as_required", "criteria", "scans", "findings", "verdict", "receipt_path", "receipt_sha256", "claims_rows"],
  "properties": {
    "schema": {"const": "execution.result.verifier/1"},
    "role": {"const": "verifier"},
    "wave": {"type": "string", "pattern": "^W[0-9]{2,3}$"},
    "task": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run": {"type": "string", "pattern": "^T[0-9]{3,}-[0-9a-f]{8}-[0-9]{8}T[0-9]{6}Z-[0-9]{1,3}$"},
    "exit_code": {"type": ["integer", "null"]},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "negative_control_failed_as_required": {"type": ["boolean", "null"], "description": "null when the task needs no negative control."},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "met", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "met": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "scans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stubs", "todos", "weakened_tests", "skip_markers", "special_casing"],
      "properties": {
        "stubs": {"type": "array", "items": {"type": "string"}},
        "todos": {"type": "array", "items": {"type": "string"}},
        "weakened_tests": {"type": "array", "items": {"type": "string"}},
        "skip_markers": {"type": "array", "items": {"type": "string"}},
        "special_casing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "claim", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{1,3}$"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "claim": {"type": "string", "minLength": 1},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "fix": {"type": "string"}
        }
      }
    },
    "verdict": {"enum": ["pass", "fail"]},
    "receipt_path": {"type": "string", "pattern": "^proofs/T[0-9]{3,}\\.json$"},
    "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "The value `proof verdict` printed; null when it wrote no receipt (exit 3 or 4). The wave script resolves done only on a pass with a non-null receipt_sha256."},
    "claims_rows": {
      "description": "Claims this task makes possible, for the claims ledger (status unverified until the freeze review).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "where", "evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "where": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
