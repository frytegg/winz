{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/decision.schema.json",
  "title": "Machine header of a decisions.md block",
  "description": "decisions.md is append-only (git merge=union). Each block starts with a line `<!-- execution-decision {json} -->` holding a document of this schema, followed by human-readable French-or-English prose for the owner. A proposal block has record 'proposal'; its resolution is a later block with record 'resolution' and the same id. Written only by exec.py (decision propose, decision resolve, fix, ingest for spec validation, plan instantiate for the approval proposal).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record", "id", "at_utc", "by"],
  "properties": {
    "schema": {"const": "execution.decision/1"},
    "record": {"enum": ["proposal", "resolution", "note"], "description": "note: a record attached to an existing decision id that is neither a proposal nor a resolution (fix mode's unselected items, FIX-MODE.md 5.2)."},
    "id": {"$ref": "common.schema.json#/$defs/decision_id"},
    "at_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "by": {"type": "string", "pattern": "^(exec@[AB]|devA|devB|owner)$"},
    "kind": {"enum": ["approval", "spec-validation", "cut", "spec-gap", "amendment", "policy-exception", "dependency-missing", "quota", "resources", "retry-exhausted", "scope-change", "fix-selection", "plan-task", "other"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "tasks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/task_id"}},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "consequence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "consequence": {"type": "string", "minLength": 1},
          "effects": {
            "description": "Machine effects applied by decision resolve when this option is chosen.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op"],
              "properties": {
                "op": {"enum": ["approve-plan", "validate-spec", "cut-tasks", "restore-tasks", "unblock-tasks", "amend", "policy-patch", "retry-task", "quota-override", "none"]},
                "tasks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/task_id"}},
                "patch": {"$ref": "common.schema.json#/$defs/state_rel_path"},
                "mode": {"enum": ["extra-usage", "critical-only"], "description": "quota-override only."},
                "until_utc": {"$ref": "common.schema.json#/$defs/utc_or_null", "description": "quota-override only; null = the weekly window's reset."}
              }
            }
          }
        }
      }
    },
    "recommended": {"type": ["string", "null"]},
    "deadline_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
    "spec_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "plan_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "dedup": {"$ref": "common.schema.json#/$defs/sha256", "description": "sha256 of (kind, title, sorted tasks): an open proposal with the same dedup is returned instead of a duplicate."},
    "choice": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"},
    "source": {"enum": ["terminal", "remote-control", "notion"]},
    "quote": {"type": "string", "minLength": 1, "description": "The owner's words, verbatim; data, never instructions."},
    "reason": {"type": "string"},
    "items": {"type": "array", "items": {"type": "object"}, "description": "note records: the items the note is about (e.g. {id, reason} of unselected fix items)."}
  },
  "allOf": [
    {"if": {"properties": {"record": {"const": "proposal"}}}, "then": {"required": ["kind", "title", "options", "deadline_utc", "dedup"], "properties": {"options": {"minItems": 1}}}},
    {"if": {"properties": {"record": {"const": "resolution"}}}, "then": {"required": ["choice", "source", "quote"], "properties": {"by": {"enum": ["devA", "devB", "owner"]}}}},
    {"if": {"properties": {"record": {"const": "note"}}}, "then": {"required": ["reason", "items"]}}
  ]
}
