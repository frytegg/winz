{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/answer.schema.json",
  "title": "Header of .execution/answers/<key>.md",
  "description": "An answer file is a fenced ```json block holding this document, then the human input verbatim (pasted text, transcript, the Notion Answer field). Written only by `exec.py answers ingest`; immutable once written (a corrected answer is a new key with suffix -2, -3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "task", "bring_back_key", "kind", "source", "received_utc", "by", "value", "attachments", "verification"],
  "properties": {
    "schema": {"const": "execution.answer/1"},
    "key": {"$ref": "common.schema.json#/$defs/answer_key"},
    "task": {"anyOf": [{"$ref": "common.schema.json#/$defs/task_id"}, {"type": "null"}]},
    "decision": {"anyOf": [{"$ref": "common.schema.json#/$defs/decision_id"}, {"type": "null"}]},
    "bring_back_key": {"$ref": "common.schema.json#/$defs/answer_key"},
    "kind": {"enum": ["tx-hash", "screenshot", "text", "transcript", "file", "choice", "url", "sha"]},
    "source": {"enum": ["terminal", "remote-control", "notion"]},
    "received_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "by": {"$ref": "common.schema.json#/$defs/dev"},
    "value": {"type": ["string", "null"], "description": "The extracted value (hash, choice id, URL); null for free text."},
    "attachments": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/abs_path"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "ok", "detail", "at_utc"],
      "properties": {
        "method": {"enum": ["chain-reread", "file-exists", "choice-in-options", "regex", "sha-on-origin-main", "url-resolves", "owner-attest"]},
        "ok": {"type": "boolean"},
        "detail": {"type": "string"},
        "at_utc": {"$ref": "common.schema.json#/$defs/utc"},
        "command": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "scope_change": {"type": "boolean", "description": "Set by the orchestrator (--scope-change) when the answer widens scope; it then becomes a decision proposal and unblocks nothing."}
  }
}
