{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/merge-receipt.schema.json",
  "title": "Merge queue receipt: .execution/local/results/<wave>/<task>.merge.a<attempt>.json",
  "description": "Written only by exec.py: `merge` (run by the implementer as its last step, by an integrator step after a test-designer or fragment step, or by the orchestrator with --by orchestrator), `results.write_gate_receipt` at `wave emit` for gate tasks (mode gate), or `merge` itself for state-only tasks (mode state-only). Printed as merge's stdout data. The not-rocket-science rule: build the candidate on origin/main (worktrees: rebase the lane; single-tree: a commit from the task's write paths through a temporary index, never touching the shared checkout), gate that exact tree, push <sha>:main (a non-fast-forward rejection is the compare-and-set). The receipt is evidence on its own: running -> built needs only a landed receipt (SCHEMAS.md 4.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "attempt", "rerun", "wave", "lane", "mode", "branch", "origin_before", "head_before", "landed_sha", "outcome", "push_attempts", "gates", "task_proof", "scans", "conflict_files", "worktree_removed", "started_utc", "finished_utc"],
  "properties": {
    "schema": {"const": "execution.merge-receipt/1"},
    "task": {"$ref": "common.schema.json#/$defs/task_id"},
    "attempt": {"type": "integer", "minimum": 1},
    "rerun": {"type": "integer", "minimum": 0, "description": "The run key k of a<n>r<k>: the status reruns count when this merge ran."},
    "wave": {"$ref": "common.schema.json#/$defs/wave_id"},
    "lane": {"anyOf": [{"$ref": "common.schema.json#/$defs/lane_id"}, {"type": "null"}], "description": "null for gate and state-only receipts of laneless tasks."},
    "mode": {"enum": ["worktrees", "single-tree", "gate", "state-only"]},
    "branch": {"type": "string", "minLength": 1},
    "origin_before": {"$ref": "common.schema.json#/$defs/sha40"},
    "head_before": {"$ref": "common.schema.json#/$defs/sha40"},
    "landed_sha": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha40"}, {"type": "null"}]},
    "outcome": {"enum": ["landed", "conflict", "gate-failed", "scan-failed", "refused", "push-rejected-exhausted", "nothing-to-merge"]},
    "push_attempts": {"type": "integer", "minimum": 0, "maximum": 3},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "result_path", "exit_code", "flaky"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "result_path": {"$ref": "common.schema.json#/$defs/abs_path_or_null"},
        "exit_code": {"type": ["integer", "null"]},
        "flaky": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "exit_code"],
      "properties": {
        "run": {"anyOf": [{"$ref": "common.schema.json#/$defs/run_ref"}, {"type": "null"}]},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "detail", "positive_control"],
        "properties": {
          "id": {"enum": ["writes-scope", "protected", "trailers", "conventional", "never-show", "secrets", "test-integrity", "todo-judge-facing", "push-freeze"]},
          "state": {"$ref": "common.schema.json#/$defs/gate_state"},
          "detail": {"type": "string"},
          "positive_control": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ran", "caught"],
                "properties": {"ran": {"type": "boolean"}, "caught": {"type": "boolean"}}
              }
            ]
          }
        }
      }
    },
    "conflict_files": {"type": "array", "items": {"type": "string"}},
    "worktree_removed": {"type": "boolean"},
    "started_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "finished_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "timings": {
      "description": "Seconds per step (fetch, build, scans, gates, proof, push), the input of the 9-minute budget (CLI.md 0.6).",
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "candidate_ref": {"type": ["string", "null"], "description": "single-tree: refs/exec/<task>/a<n>r<k>, the commit built from the write paths."},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "landed"}}}, "then": {"properties": {"landed_sha": {"$ref": "common.schema.json#/$defs/sha40"}}}}
  ]
}
