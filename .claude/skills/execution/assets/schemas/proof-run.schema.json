{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/proof-run.schema.json",
  "title": "One execution of a task's proof: .execution/local/proof-runs/<task>/<run_id>/run.json",
  "description": "Written only by `exec.py proof run` (usually invoked by the verifier agent), and by exec.py for the file proofs of manual and decision tasks (checkout none, by.role orchestrator). Raw evidence, never a verdict: the verdict is a separate receipt (proof-receipt.schema.json) that cites this run by id; `proof verdict` commits a copy of this document (without output.log) to proofs/runs/<task>/<run_id>.json for the other executor. A run happens in a clean checkout of `sha` outside the repository (merge's pre-push check excepted: in-place); command proofs run through /harden's gates.py with an explicit --config and --out-dir inside this run's directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "task", "sha", "plan_version", "proof_hash", "type", "command", "checkout", "install", "started_utc", "finished_utc", "exit_code", "timed_out", "output_sha256", "output_path", "output_tail", "expectation", "negative_control", "gates_result_path", "by"],
  "properties": {
    "schema": {"const": "execution.proof-run/1"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_ref"},
    "task": {"$ref": "common.schema.json#/$defs/task_id"},
    "sha": {"$ref": "common.schema.json#/$defs/sha40"},
    "plan_version": {"type": "integer", "minimum": 1},
    "proof_hash": {"$ref": "common.schema.json#/$defs/sha256", "description": "proof_digest() of the plan's proof object at run time (SCHEMAS.md 1.4)."},
    "type": {"$ref": "common.schema.json#/$defs/proof_type"},
    "command": {"type": ["string", "null"], "description": "The exact command line run (command, tx reader, ci query); null for file/url/human-attest."},
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "removed"],
      "properties": {
        "kind": {"enum": ["clone", "worktree", "in-place", "none"], "description": "clone: the default (core.longpaths, refs/exec fetched). in-place: merge's pre-push check on the tree it gated. none: a file proof of a manual or decision task evaluated by exec.py."},
        "path": {"$ref": "common.schema.json#/$defs/abs_path_or_null"},
        "removed": {"type": "boolean"}
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ran", "exit_code", "duration_s"],
      "properties": {
        "ran": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "duration_s": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "started_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "finished_utc": {"$ref": "common.schema.json#/$defs/utc"},
    "exit_code": {"type": ["integer", "null"], "description": "null when the command could not start or the type has no exit code."},
    "timed_out": {"type": "boolean"},
    "output_sha256": {"$ref": "common.schema.json#/$defs/sha256", "description": "sha256 of the full captured stdout+stderr (or of the fetched body / file bytes)."},
    "output_path": {"$ref": "common.schema.json#/$defs/abs_path"},
    "output_tail": {"type": "string", "maxLength": 8000},
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["met", "details"],
      "properties": {
        "met": {"type": "boolean"},
        "details": {"$ref": "common.schema.json#/$defs/string_list"}
      }
    },
    "negative_control": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ran", "exit_code", "met", "output_sha256"],
          "properties": {
            "kind": {"enum": ["pre-implementation", "planted-defect", "forgery"]},
            "ran": {"type": "boolean"},
            "exit_code": {"type": ["integer", "null"]},
            "met": {"type": "boolean", "description": "true iff the control FAILED as required (non-zero exit / expectation not met)."},
            "output_sha256": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      ]
    },
    "gates_result_path": {"$ref": "common.schema.json#/$defs/abs_path_or_null"},
    "by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "executor"],
      "properties": {
        "role": {"enum": ["verifier", "integrator", "orchestrator", "implementer", "replay", "test-designer", "reviewer"]},
        "agent_type": {"anyOf": [{"$ref": "common.schema.json#/$defs/agent_type"}, {"type": "null"}]},
        "executor": {"$ref": "common.schema.json#/$defs/executor"},
        "rerun": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/error"}}
  }
}
