{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/result-implementer.schema.json",
  "title": "Structured result of the execution-implementer agent",
  "description": "Self-contained (inlined as the agent() schema). Receipts, not prose: what was committed, where, and the agent's own proof run with its real exit code. The implementer's own run is never evidence of done; it only lets the wave skip a doomed merge. Recorded with `exec.py result put --role implementer`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "wave", "task", "attempt", "status", "branch", "head_sha", "worktree_path", "files_changed", "commit_message_file", "own_proof_run", "merge", "dx_rows", "rebuttals", "blocked", "notes"],
  "properties": {
    "schema": {"const": "execution.result.implementer/1"},
    "role": {"const": "implementer"},
    "wave": {"type": "string", "pattern": "^W[0-9]{2,3}$"},
    "task": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["built", "failed", "blocked"]},
    "branch": {"type": ["string", "null"]},
    "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "worktree_path": {"type": ["string", "null"]},
    "files_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "commit_message_file": {"type": ["string", "null"], "description": "The file passed to git commit -F (conventional commit, a cmd: line, no trailers)."},
    "own_proof_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "output_tail"],
      "properties": {
        "command": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "output_tail": {"type": "string", "maxLength": 4000}
      }
    },
    "merge": {
      "description": "What `exec.py merge` printed for this attempt (the receipt file is the evidence; this copy lets the wave script hand landed_sha to the verifier). null when the implementer did not reach the merge step.",
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_path", "outcome", "landed_sha", "exit_code"],
          "properties": {
            "receipt_path": {"type": ["string", "null"], "pattern": "^local/results/W[0-9]{2,3}/T[0-9]{3,}\\.merge\\.a[0-9]+\\.json$", "description": "null when merge printed no receipt (exit 3: time budget, lock timeout, environment)."},
            "outcome": {"enum": ["landed", "conflict", "gate-failed", "scan-failed", "refused", "push-rejected-exhausted", "nothing-to-merge", null]},
            "landed_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "exit_code": {"type": "integer", "description": "3 = environment or budget: the wave script reruns the task without counting an attempt."},
            "error_code": {"type": ["string", "null"], "pattern": "^E_[A-Z0-9_]{2,40}$"}
          }
        }
      ]
    },
    "dx_rows": {
      "description": "Developer-experience journal rows written at the moment of friction (verbatim error text); appended to profile.phase_b.dx_journal by wave ingest in /hackathon's dx-journal.md columns, Who filled as '<agent type> <task>', marked UNVERIFIED.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when_utc", "where", "tried", "happened", "reproduce", "time_lost_min"],
        "properties": {
          "when_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "where": {"type": "string", "minLength": 1},
          "tried": {"type": "string", "minLength": 1},
          "happened": {"type": "string", "minLength": 1},
          "reproduce": {"type": "string", "minLength": 1, "description": "The exact request, command or URL a reader can re-run (/hackathon's rule: a row a reader cannot re-run is an anecdote)."},
          "time_lost_min": {"type": "number", "minimum": 0}
        }
      }
    },
    "rebuttals": {
      "description": "On a fix attempt: verifier findings the implementer contests, each with evidence (command + output) a fresh verifier can re-run.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "evidence"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F[0-9]{1,3}$"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocked": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "needed"],
          "properties": {
            "kind": {"enum": ["manual", "decision", "dependency"]},
            "reason": {"type": "string", "minLength": 1},
            "needed": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "notes": {"type": "string", "maxLength": 2000}
  }
}
