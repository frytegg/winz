{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.execution.invalid/event.schema.json",
  "title": "One line of .execution/events.jsonl (append-only, the resume source)",
  "description": "Appended only by exec.py under the state lock (execlib.events.append); hook events are first written by hooks to local/hook-events.jsonl and imported by `exec.py status` with their own id, so each appears once. The state repo's .gitattributes sets `events.jsonl merge=union`, so the two executors' appends never conflict; readers order lines by (ts, executor, seq). Never a secret, never a raw agent transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "actor", "type", "data"],
  "properties": {
    "ts": {"$ref": "common.schema.json#/$defs/utc_precise"},
    "actor": {
      "description": "Who caused it: exec:<subcommand> run by orchestrator A|B, agent:<role>, hook:<name>, owner, devB.",
      "type": "string",
      "pattern": "^(exec:[a-z][a-z-]*( [a-z][a-z-]*)?@[AB]|agent:(planner|test-designer|implementer|integrator|verifier|reviewer|critic|probe|convergence)@[AB]|hook:(stop-gate|session-start|session-end|stop-failure|pre-tool-guard|user-prompt)@[AB]|owner|devB)$"
    },
    "type": {
      "enum": [
        "run.init", "run.state", "preflight", "ingest", "sync",
        "plan.instantiated", "plan.validated", "plan.approved", "plan.amended", "catalogue.generated",
        "schedule", "simulate", "due",
        "wave.emitted", "wave.launched", "wave.launch-failed", "wave.ingested",
        "result.recorded", "task.status",
        "merge.landed", "merge.conflict", "merge.failed",
        "proof.run", "proof.verdict",
        "manual.posted", "answer.ingested", "answer.rejected", "answer.relayed",
        "decision.proposed", "decision.resolved",
        "governor", "quota",
        "notion.batch", "notion.ack", "notion.outbox", "notion.poll",
        "hooks.installed", "hooks.uninstalled", "hooks.bound", "hooks.rekeyed", "hooks.canary",
        "agents.installed",
        "stop.allow", "stop.continue", "stop.stuck", "stop.failure", "session.start", "guard.deny", "guard.attest",
        "completion.generated", "completion.run", "harden-ready.run", "handover",
        "fix.parsed", "fix.selected",
        "report.written", "resume", "error"
      ]
    },
    "data": {"type": "object"},
    "executor": {"$ref": "common.schema.json#/$defs/executor"},
    "seq": {"type": "integer", "minimum": 0, "description": "Per-executor monotonic counter (local/state.json events_seq)."},
    "id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "Dedup id for imported hook events: first 16 hex of sha256 of the hook line."},
    "session_id": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "task.status"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["task", "from", "to", "evidence"],
            "properties": {
              "task": {"$ref": "common.schema.json#/$defs/task_id"},
              "from": {"$ref": "common.schema.json#/$defs/task_status"},
              "to": {"$ref": "common.schema.json#/$defs/task_status"},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "run.state"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["from", "to", "reason"],
            "properties": {
              "from": {"anyOf": [{"$ref": "common.schema.json#/$defs/run_state"}, {"type": "null"}]},
              "to": {"$ref": "common.schema.json#/$defs/run_state"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["wave.emitted", "wave.launched", "wave.launch-failed", "wave.ingested"]}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["wave"],
            "properties": {"wave": {"$ref": "common.schema.json#/$defs/wave_id"}}
          }
        }
      }
    },
    {
      "description": "Read by the dev B setup checker (TWO-DEV.md 8.3): flat fields, no nested objects.",
      "if": {"properties": {"type": {"const": "preflight"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["for", "strict", "ok", "failed", "skipped", "open", "version"],
            "properties": {
              "for": {"enum": ["rehearsal", "event"]},
              "strict": {"const": true},
              "ok": {"type": "boolean"},
              "failed": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0},
              "open": {"type": "array", "items": {"type": "string", "pattern": "^PF-[0-9]{2}$"}},
              "checks_failed": {"type": "array", "items": {"type": "string", "pattern": "^PF-[0-9]{2}$"}},
              "version": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "hooks.canary"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "description": "The binding canary carries bound, session_id, permission_mode; a probe canary carries probe, layer, as_role, agent_type, role_resolved, session_id.",
            "properties": {
              "bound": {"type": "boolean"},
              "session_id": {"type": ["string", "null"]},
              "permission_mode": {"type": ["string", "null"]},
              "hook_seen_utc": {"$ref": "common.schema.json#/$defs/utc_or_null"},
              "latency_ms": {"type": ["number", "null"]},
              "probe": {"type": "boolean"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "notion.ack"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["batch", "op", "purpose", "key", "ok"],
            "properties": {
              "batch": {"type": "string"},
              "op": {"type": "string"},
              "purpose": {"type": "string"},
              "key": {"type": "string"},
              "ok": {"type": "boolean"}
            }
          }
        }
      }
    }
  ]
}
