{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:choices:1",
  "title": "Owner choices (H1, H2, H3) - a test copy of the shape lane B04 relies on (FRONTEND.md 6.4)",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "H1": {
      "type": "object",
      "required": [
        "pick",
        "change",
        "answered_at",
        "by",
        "channel",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "pick": {
          "type": "string",
          "pattern": "^[A-C]$"
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "answered_at": {
          "$ref": "#/$defs/utc"
        },
        "by": {
          "$ref": "#/$defs/by"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "H2": {
      "type": "object",
      "required": [
        "pick",
        "change",
        "answered_at",
        "by",
        "channel",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "pick": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^[1-9][0-9]*$",
          "minimum": 1
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "answered_at": {
          "$ref": "#/$defs/utc"
        },
        "by": {
          "$ref": "#/$defs/by"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  },
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "Z$"
    },
    "change": {
      "type": "string",
      "maxLength": 400
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "notion",
        "remote-control",
        "ask-user-question",
        "terminal"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
