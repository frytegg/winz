{
  "schema": "execution.policy/1",
  "git": {
    "commit": true,
    "push": true,
    "force": "never",
    "history_rewrite": "never",
    "push_freeze_utc": "2026-10-03T13:45:00Z",
    "conventional_commits": true,
    "attribution_trailers": "never"
  },
  "networks": {
    "testnet": {
      "allowed": false,
      "chains": []
    },
    "mainnet": {
      "mode": "read-only",
      "setup_task": null,
      "ceiling": null,
      "unit": null,
      "per_wave_ceiling": null,
      "broadcast_patterns": []
    }
  },
  "deny_endpoints": [],
  "deny_commands": [],
  "fences": {
    "deny_read": [],
    "deny_write_outside_repo": true,
    "allow_write_outside": [
      "C:/x/qc/scratch"
    ]
  },
  "secrets": {
    "env_file": null,
    "agents_read_keys": false,
    "loading": "in-process"
  }
}
