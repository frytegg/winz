{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:profile-frontend:1",
  "title": "/frontend profile block",
  "description": "The frontend block of /execution's profile.json, or a standalone .frontend/profile.json in mode B (scripts/CONTRACTS.md 6.1; /execution ARCHITECTURE.md 4.3 validates its block against this file). judged_surface, stack and hosting describe the project and have no default (lib/profile.mjs REQUIRED_FIELDS); every other key is optional because lib/profile.mjs applies the defaults (mode full, run_mode B, the three viewports, review_surface claude-design, critique 3/3/5, external_requests false, record_mode false); $defs/resolved is the shape after defaults. When the profile is /execution's, its top-level prework {code, designs, until_utc} is authoritative (prework_designs only overrides it), phase_b.claims_ledger is the claims ledger, and workspace.private_dir may sit at top level or here. Paths other than paths.design are absolute and outside the product repo, because a verifier re-runs proofs from a clean checkout.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "full",
        "small"
      ],
      "default": "full",
      "description": "small: 1-2 h of UI budget; brief, 1-2 directions, a wordmark, one page, at most one critique round."
    },
    "run_mode": {
      "enum": [
        "A",
        "B"
      ],
      "default": "B",
      "description": "A: task templates inside /execution, state in <repo>/.execution/frontend. B: standalone, state in <repo>/.frontend."
    },
    "judged_surface": {
      "enum": [
        "site",
        "app",
        "site+app",
        "video",
        "readme"
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "boolean",
          "default": false,
          "description": "Shown on a projector or stage: light surfaces or 7:1 text, key text 32-48 px (FD20)."
        },
        "projector_zoom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "default": 1.25
        },
        "video": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": false
            },
            {
              "$ref": "#/$defs/video"
            }
          ],
          "default": null,
          "description": "Set when the event judges a recorded video; turns on the recording gates in --phase build. null or false: no video."
        },
        "async_readme": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/viewport"
      },
      "default": [
        {
          "name": "desktop",
          "width": 1440,
          "height": 900,
          "dpr": 1
        },
        {
          "name": "mobile",
          "width": 390,
          "height": 844,
          "dpr": 2,
          "isMobile": true,
          "hasTouch": true
        },
        {
          "name": "reflow",
          "width": 320,
          "height": 640,
          "dpr": 1
        }
      ]
    },
    "record_mode": {
      "type": "boolean",
      "default": false,
      "description": "Render routes with ?record=1: named demo data, fixed clock, no loops, hover content shown at rest."
    },
    "ready_flag": {
      "type": "boolean",
      "default": false,
      "description": "The app sets window.__FRONTEND_READY__ = true once its data is loaded."
    },
    "stack": {
      "enum": [
        "vite-react",
        "next",
        "static-html",
        "existing"
      ]
    },
    "hosting": {
      "enum": [
        "vercel",
        "gh-pages",
        "fly",
        "existing",
        "local"
      ]
    },
    "external_requests": {
      "type": "boolean",
      "default": false,
      "description": "false: any request to another origin fails render.requests."
    },
    "prework_designs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides the top-level prework.designs of /execution's profile; events that forbid designs before kickoff get no visual (tokens, logo, mock) before T0.",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "until_utc": {
          "$ref": "#/$defs/utcOrNull"
        }
      }
    },
    "review_surface": {
      "enum": [
        "claude-design",
        "board",
        "terminal"
      ],
      "default": "claude-design"
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "rounds_max": 3,
        "critics": 3,
        "probes": 5
      },
      "properties": {
        "rounds_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3,
          "description": "Small mode caps it at 1."
        },
        "critics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "default": 3
        },
        "probes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "default": 5
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Reference sites proposed from the brief's customers, each with where its URL came from; FE-01 records the owner's confirmation.",
      "items": {
        "type": "object",
        "required": [
          "customer",
          "url",
          "source",
          "owner_confirmed"
        ],
        "additionalProperties": false,
        "properties": {
          "customer": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner_confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "sponsors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sponsorId"
      },
      "description": "Sponsor ids; loadAllowlists() selects these entries of assets/sponsor-allowlist.json."
    },
    "sponsor_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/sponsorId"
          },
          {
            "type": "object",
            "required": [
              "sponsor"
            ],
            "properties": {
              "sponsor": {
                "$ref": "#/$defs/sponsorId"
              }
            }
          }
        ]
      },
      "deprecated": true,
      "description": "Alias of sponsors, the name /execution's ARCHITECTURE.md 4.3 uses: sponsor ids, or FD21 entries of which lib/profile.mjs keeps only the sponsor id (the entries themselves always come from assets/sponsor-allowlist.json). Prefer sponsors."
    },
    "tells": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "description": "tells.score fails above it; null reports only until calibration sets it."
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {
          "type": "string",
          "default": "design",
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$",
          "description": "Repository-relative design folder."
        },
        "claims_ledger": {
          "$ref": "#/$defs/absPathOrNull"
        },
        "never_show": {
          "$ref": "#/$defs/absPathOrNull"
        },
        "feature_catalogue": {
          "$ref": "#/$defs/absPathOrNull"
        },
        "spec": {
          "$ref": "#/$defs/absPathOrNull"
        },
        "research": {
          "$ref": "#/$defs/absPathOrNull"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "private_dir": {
          "$ref": "#/$defs/absPathOrNull"
        }
      }
    }
  },
  "$defs": {
    "sponsorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "utcOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      ]
    },
    "absPathOrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)",
      "description": "Absolute path (Windows drive or POSIX root), or null."
    },
    "video": {
      "type": "object",
      "required": [
        "max_s",
        "width",
        "height",
        "embed"
      ],
      "additionalProperties": false,
      "properties": {
        "max_s": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 240
        },
        "embed": {
          "enum": [
            "pptx",
            "key",
            "mp4"
          ],
          "description": "A 97-2003 .ppt turns embedded video into a still: pptx or key only (FD20)."
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": [
        "name",
        "width",
        "height",
        "dpr"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "isMobile": {
          "type": "boolean"
        },
        "hasTouch": {
          "type": "boolean"
        },
        "colorScheme": {
          "enum": [
            "light",
            "dark",
            "no-preference"
          ]
        },
        "reducedMotion": {
          "enum": [
            "reduce",
            "no-preference"
          ]
        }
      }
    },
    "resolved": {
      "description": "The frontend block with every default written out, as a fully specified profile file would hold it. lib/profile.mjs's in-memory Profile adds prework, project and source on top and is not this shape.",
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "required": [
            "mode",
            "run_mode",
            "judged_surface",
            "format",
            "viewports",
            "record_mode",
            "ready_flag",
            "stack",
            "hosting",
            "external_requests",
            "prework_designs",
            "review_surface",
            "critique",
            "budget",
            "references",
            "sponsors",
            "tells",
            "paths",
            "workspace"
          ],
          "properties": {
            "critique": {
              "required": [
                "rounds_max",
                "critics",
                "probes"
              ]
            },
            "paths": {
              "required": [
                "design",
                "claims_ledger",
                "never_show",
                "feature_catalogue",
                "spec",
                "research"
              ]
            },
            "workspace": {
              "required": [
                "private_dir"
              ]
            },
            "format": {
              "required": [
                "stage",
                "projector_zoom",
                "video",
                "async_readme"
              ]
            },
            "prework_designs": {
              "required": [
                "allowed",
                "until_utc"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "judged_surface",
    "stack",
    "hosting"
  ]
}
