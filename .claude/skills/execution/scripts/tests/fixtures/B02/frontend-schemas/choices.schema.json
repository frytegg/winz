{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend:schema:choices:1",
  "title": "Owner choices (H1, H2, H3)",
  "description": "choices.json in the state directory (scripts/CONTRACTS.md 6.3: H1, H2 and H3 answers with UTC times). In mode A the orchestrator writes each answer from the decision or manual task (FE-04, FE-06, FE-21) after reading it through Notion or Remote Control; in mode B /frontend writes it from AskUserQuestion. Comments on a Claude Design canvas are not answers, so no such channel exists here. A key is absent until its checkpoint is answered.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "H1": {
      "type": "object",
      "required": ["pick", "change", "answered_at", "by", "channel", "source"],
      "additionalProperties": false,
      "description": "Direction picked from {state}/directions/<A|B|C>/.",
      "properties": {
        "pick": {"type": "string", "pattern": "^[A-C]$"},
        "change": {"$ref": "#/$defs/change"},
        "answered_at": {"$ref": "#/$defs/utc"},
        "by": {"$ref": "#/$defs/by"},
        "channel": {"$ref": "#/$defs/channel"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "H2": {
      "type": "object",
      "required": ["pick", "change", "answered_at", "by", "channel", "source"],
      "additionalProperties": false,
      "description": "Logo candidate picked from {state}/brand/candidates/<n>/.",
      "properties": {
        "pick": {"type": ["string", "integer"], "pattern": "^[1-9][0-9]*$", "minimum": 1},
        "change": {"$ref": "#/$defs/change"},
        "answered_at": {"$ref": "#/$defs/utc"},
        "by": {"$ref": "#/$defs/by"},
        "channel": {"$ref": "#/$defs/channel"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "H3": {
      "type": "object",
      "required": ["signed_off", "changes", "answered_at", "by", "channel", "source"],
      "additionalProperties": false,
      "description": "Sign-off of the deployed preview at recording size, after /harden's review and before any recording.",
      "properties": {
        "signed_off": {"type": "boolean"},
        "changes": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Numbered changes the owner asked for; empty when signed off."},
        "url": {"type": "string", "format": "uri", "description": "The preview that was signed off."},
        "answered_at": {"$ref": "#/$defs/utc"},
        "by": {"$ref": "#/$defs/by"},
        "channel": {"$ref": "#/$defs/channel"},
        "source": {"$ref": "#/$defs/source"}
      },
      "if": {"properties": {"signed_off": {"const": false}}},
      "then": {"properties": {"changes": {"minItems": 1}}},
      "else": {"properties": {"changes": {"maxItems": 0}}}
    }
  },
  "$defs": {
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "change": {"type": "string", "maxLength": 400, "description": "At most one sentence of change; empty when none."},
    "by": {"type": "string", "minLength": 1, "description": "owner, or the developer id (devA, devB) who relayed the owner's answer."},
    "channel": {"enum": ["notion", "remote-control", "ask-user-question", "terminal"]},
    "source": {"type": "string", "minLength": 1, "description": "Where the answer is recorded, for example .execution/answers/T005.md or the Notion row."}
  }
}
