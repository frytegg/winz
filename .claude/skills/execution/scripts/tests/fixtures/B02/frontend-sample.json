     "proof": {"type": "command", "spec": {"cmd": "node {frontend_skill}/scripts/frontend-check.mjs --json --gates brand --profile {profile_abs}", "shell": "bash", "cwd": ".", "install": false}, "expect": {"summary": "exit 0", "exit_code": 0}, "max_runtime_min": 4, "negative_control": {"kind": "pre-implementation", "description": "no brand files before the task", "expect_nonzero": true}},
     "brief_refs": [], "manual": null, "required": true, "priority": "P1", "prework_class": "code", "max_attempts": 2},
    {"id": "FE-1x", "title": "Section for feature group {group}", "description": "Build the sections of {features} in {ui_root}/src/sections/{group}/.", "kind": "code", "phase": "build", "include": true, "per": "feature-group",
