     "model": "opus", "effort": "high", "verify": {"model": "opus", "effort": "high"},
     "proof": {"type": "command", "spec": {"cmd": "node {frontend_skill}/scripts/frontend-check.mjs --json --gates render --profile {profile_abs}", "shell": "bash", "cwd": ".", "install": false}, "expect": {"summary": "exit 0", "exit_code": 0}, "max_runtime_min": 5, "negative_control": {"kind": "pre-implementation", "description": "no shell before the task", "expect_nonzero": true}},
