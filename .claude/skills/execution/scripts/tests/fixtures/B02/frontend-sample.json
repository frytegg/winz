     "brief_refs": [], "manual": null, "required": true, "priority": "P1", "prework_class": "code", "max_attempts": 2},
    {"id": "FE-21", "title": "Sign off the preview (H3, owner)", "description": "The owner signs off the preview at recording size.", "kind": "manual", "phase": "deliverable", "include": true, "per": null,
