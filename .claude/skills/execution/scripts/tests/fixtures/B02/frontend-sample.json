     "brief_refs": [], "manual": null, "required": "from-requirements", "priority": "from-requirements", "prework_class": "code", "max_attempts": 2},
    {"id": "FE-20", "title": "Critique and final gates", "description": "Critique rounds and the build-phase gates.", "kind": "gate", "phase": "build", "include": true, "per": null,
     "covers": {"rule": "nfr", "nfr": {"key": "frontend-judged-ui", "title": "Judged UI built and gated by /frontend", "text": "The judged UI is built through /frontend's templates and passes frontend-check.", "priority": "P1", "required": true}},
     "depends_on": [{"ref": "@all-instances:FE-1x"}, {"template": "FE-09", "required": true}], "writes": [], "resources": ["browser", "port:{port}"],
