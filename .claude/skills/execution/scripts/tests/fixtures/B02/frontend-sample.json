{
  "schema": "execution.task-templates/1",
  "library": "frontend",
  "version": "1.0.0",
  "parameters": {
    "references": {"type": "enum", "enum": ["on", "off"], "default": "on", "description": "FE-01 and FE-02 included, FE-03 after FE-02 (on); dropped, FE-03 after FE-00 (off)."},
    "mode": {"type": "enum", "enum": ["full", "small"], "from_profile": "/frontend/mode", "description": "profile.frontend.mode (authoritative)."},
    "ui_root": {"type": "glob", "default": "ui", "description": "Repository-relative UI folder."},
    "port": {"type": "port", "default": 5173, "description": "Preview port."}
  },
  "templates": [
