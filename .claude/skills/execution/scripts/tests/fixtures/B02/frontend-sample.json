     "brief_refs": [], "manual": {"steps": ["Confirm each reference URL."], "bring_back": [{"key": "{task_id}-refs", "kind": "text", "verify": {"method": "owner-attest"}}], "where": "phone", "latest_start_utc": "{latest_start:cpm:0}", "options_source": null, "options": [], "decision_deadline_utc": null},
     "required": true, "priority": "P1", "prework_class": "research", "max_attempts": 2, "owner": "devA"},
