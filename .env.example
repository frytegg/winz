# Template of every variable the web app and the engine read. No values here.
# Copy to .env (never committed). Production values live in Vercel and Render.

# --- App -------------------------------------------------------------------
APP_ENV=
APP_BASE_URL=
APP_LOG_LEVEL=
# "true" makes every API route answer with its example payload (front-end work without a backend).
APP_API_MOCK=
# The browser's half of the simulated mode: the screens use the simulated sign-in and the scenario
# picker when it is "true". Set it WITH APP_API_MOCK, never alone (a simulated client against a real
# server, or the reverse), and never on a production deployment: unlike APP_API_MOCK, which the
# server ignores in production, this one is compiled into the JavaScript at build time.
NEXT_PUBLIC_APP_API_MOCK=
APP_ADMIN_DEMO_KEY=
# "paper" (fills simulated on the live Gemini book) or "gemini-sandbox" (real sandbox orders).
APP_EXECUTION_VENUE=
# Optional, only where direct outbound connections are blocked (sandboxes): proxy for the Gemini WebSocket.
APP_HTTPS_PROXY_URL=
APP_PROXY_CA_FILE=

# Engine only, optional: port of its health listener (GET /healthz). Render sets it (10000) on a
# web service. Unset or empty: the engine listens on nothing.
PORT=

# Engine only, optional: the engine lease (only the engine holding it works on the database; a
# second one waits as a standby). How long a renewal holds it (10000 to 300000 ms, default 15000),
# how often the leader renews it (at most (ttl - 5000) / 3, default 3000), how often a standby asks
# for it (100 ms to the ttl, default 1000). The leader stops its services by itself after
# ttl - 5000 ms without a renewal.
ENGINE_LEASE_TTL_MS=
ENGINE_LEASE_RENEW_MS=
ENGINE_LEASE_STANDBY_POLL_MS=

# --- Database (Supabase Postgres) ------------------------------------------
# Deployed: Supabase's SESSION pooler (port 5432), as Connect shows it. Both clients require TLS for
# any host that is not local; never add sslmode=disable (docs/deploy.md, step 1.4).
DB_URL=
# Optional: connections of one process's pool. Engine: default 20 (6 to 100). Web app: default 3
# (1 to 20), per server instance. Through Supabase's session pooler both count against one pool
# (15 by default): see docs/deploy.md, step 1.4.
DB_POOL_MAX=
# Public (shipped to every browser): the publishable key (sb_publishable_…) or the legacy anon JWT,
# never a secret key (sb_secret_…) nor service_role. `pnpm env:check` refuses a NEXT_PUBLIC_ value
# shaped like a secret (sk_, rk_, whsec_, sb_secret_, 32-byte hex, a service_role JWT).
# Read by the live odds feed (apps/web/lib/realtime/use-live-odds.ts); without them every page polls
# the API every 2 s. Supabase's Connect dialog names the key NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# paste its value under NEXT_PUBLIC_SUPABASE_ANON_KEY, the name the code reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Arc testnet -----------------------------------------------------------
ARC_CHAIN_ID=
ARC_RPC_URL=
ARC_RPC_FALLBACK_URL=
# Engine (required) and web app (always set it there too: the explorer links of every promo).
ARC_ESCROW_ADDRESS=
# Block the escrow was deployed at (see packages/contracts/deployments/<chainId>.json).
ARC_ESCROW_DEPLOY_BLOCK=
ARC_USDC_ADDRESS=
ARC_RELAYER_PRIVATE_KEY=
ARC_ORACLE_PRIVATE_KEY=
# Optional: limits every engine request keeps towards the node (defaults 10, 4, eth_getLogs).
ARC_RPC_MAX_REQUESTS_PER_SECOND=
ARC_RPC_MAX_HEAVY_REQUESTS_PER_SECOND=
ARC_RPC_HEAVY_METHODS=
# Optional: transactions of one signer broadcast and not mined yet at the same time (default 8,
# 1 to 64; 1 sends one at a time). Only buyFor, chargeHedge and refundBatch travel together.
ARC_TX_MAX_IN_FLIGHT=

# --- Gemini ----------------------------------------------------------------
GEMINI_API_URL=
GEMINI_WS_URL=
GEMINI_SANDBOX_API_URL=
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=
# incremental (default) or time, as chosen when the sandbox key was created (docs/gemini-sandbox.md)
GEMINI_SANDBOX_NONCE_MODE=
# Optional: the sandbox contract the real-order check uses instead of the one it chooses
GEMINI_SANDBOX_CHECK_SYMBOL=
# true: the engine runs the real-order check (SPEC HE-10) once at boot, with the two keys above
APP_VENUE_CHECK_ON_BOOT=
# true: the check may accept the sandbox account's Prediction Markets terms
APP_VENUE_CHECK_ACCEPT_TERMS=

# --- Stripe (test mode) ----------------------------------------------------
# The engine starts without STRIPE_SECRET_KEY, and then only sells sales replayed by the demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public: the publishable key (pk_test_…), never the secret one.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Privy -----------------------------------------------------------------
# Both on the web app AND on the engine, the same application's values (docs/deploy.md, step 3).
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
# Engine only, and only without Privy: 32-byte hex secret (0x…) from which buyers' demo wallets are
# derived. Demo only: these are not customers' wallets. Keep it, and never change it for a given
# database: it is what sweeps test funds back, and a buyer's wallet must stay the same.
# Never on an engine whose database a Privy web app uses: every buyer it handled would then get 409
# "This e-mail belongs to another account" at sign-in (docs/deploy.md, step 2.3).
APP_DEMO_WALLET_SEED=

# --- QuickNode Streams -----------------------------------------------------
# Web app only (never NEXT_PUBLIC_). Without the token the webhook answers 503 (docs/quicknode.md).
QUICKNODE_STREAMS_TOKEN=
# Optional: QuickNode's name of the stream's network, checked on every delivery (default arc-testnet).
QUICKNODE_STREAMS_NETWORK=
