# Template of every variable the web app and the engine read. No values here.
# Copy to .env (never committed). Production values live in Vercel and Railway.

# --- App -------------------------------------------------------------------
APP_ENV=
APP_BASE_URL=
APP_LOG_LEVEL=
# "true" makes every API route answer with its example payload (front-end work without a backend).
APP_API_MOCK=
APP_ADMIN_DEMO_KEY=
# "paper" (fills simulated on the live Gemini book) or "gemini-sandbox" (real sandbox orders).
APP_EXECUTION_VENUE=
# Optional, only where direct outbound connections are blocked (sandboxes): proxy for the Gemini WebSocket.
APP_HTTPS_PROXY_URL=
APP_PROXY_CA_FILE=

# Engine only, optional: port of its health listener (GET /healthz). Railway sets it. Unset or
# empty: the engine listens on nothing.
PORT=

# --- Database (Supabase Postgres) ------------------------------------------
DB_URL=
# Optional: connections of the engine's pool (default 20).
DB_POOL_MAX=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Arc testnet -----------------------------------------------------------
ARC_CHAIN_ID=
ARC_RPC_URL=
ARC_RPC_FALLBACK_URL=
ARC_ESCROW_ADDRESS=
# Block the escrow was deployed at (see packages/contracts/deployments/<chainId>.json).
ARC_ESCROW_DEPLOY_BLOCK=
ARC_USDC_ADDRESS=
ARC_RELAYER_PRIVATE_KEY=
ARC_ORACLE_PRIVATE_KEY=
# Optional: limits every engine request keeps towards the node (defaults 10, 4, eth_getLogs).
ARC_RPC_MAX_REQUESTS_PER_SECOND=
ARC_RPC_MAX_HEAVY_REQUESTS_PER_SECOND=
ARC_RPC_HEAVY_METHODS=
# Optional: transactions of one signer broadcast and not mined yet at the same time (default 8,
# 1 to 64; 1 sends one at a time). Only buyFor, chargeHedge and refundBatch travel together.
ARC_TX_MAX_IN_FLIGHT=

# --- Gemini ----------------------------------------------------------------
GEMINI_API_URL=
GEMINI_WS_URL=
GEMINI_SANDBOX_API_URL=
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=

# --- Stripe (test mode) ----------------------------------------------------
# The engine starts without STRIPE_SECRET_KEY, and then only sells sales replayed by the demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Privy -----------------------------------------------------------------
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
# Engine only, and only without Privy: 32-byte hex secret (0x…) from which buyers' demo wallets are
# derived. Demo only: these are not customers' wallets. Keep it, and never change it for a given
# database: it is what sweeps test funds back, and a buyer's wallet must stay the same.
APP_DEMO_WALLET_SEED=

# --- QuickNode Streams -----------------------------------------------------
# Web app only (never NEXT_PUBLIC_). Without the token the webhook answers 503 (docs/quicknode.md).
QUICKNODE_STREAMS_TOKEN=
# Optional: QuickNode's name of the stream's network, checked on every delivery (default arc-testnet).
QUICKNODE_STREAMS_NETWORK=
